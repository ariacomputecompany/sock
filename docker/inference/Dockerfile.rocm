FROM rocm/dev-ubuntu-24.04:7.2.4

ARG DEBIAN_FRONTEND=noninteractive
ARG LINX_REPO=https://github.com/ariacomputecompany/linx.git
ARG LINX_REF=master
ARG VLLM_VERSION=0.11.0
ARG PYTORCH_ROCM_ARCH=gfx1151
ARG MAX_JOBS=8

ENV PYTHONUNBUFFERED=1 \
    PYTHONNOUSERSITE=1 \
    PYTHONHASHSEED=0 \
    TOKENIZERS_PARALLELISM=false \
    VLLM_TARGET_DEVICE=rocm \
    VLLM_WORKER_MULTIPROC_METHOD=spawn \
    VLLM_USE_V2_MODEL_RUNNER=0 \
    VLLM_ROCM_FP8_PADDING=1 \
    VLLM_ROCM_MOE_PADDING=1 \
    VLLM_FLA_AUTOTUNE_POLICY=platform \
    PYTORCH_ROCM_ARCH=${PYTORCH_ROCM_ARCH} \
    MAX_JOBS=${MAX_JOBS}

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      bash \
      build-essential \
      ca-certificates \
      clang \
      cmake \
      curl \
      git \
      jq \
      libnuma-dev \
      libopenblas0-pthread \
      miopen-hip \
      ninja-build \
      pkg-config \
      python3 \
      python3-dev \
      python3-pip \
      python3-venv \
      rocm-libs \
      sqlite3 && \
    rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable
ENV PATH=/root/.cargo/bin:/opt/sock/vllm/.venv/bin:${PATH}

WORKDIR /opt/sock
COPY . /opt/sock

COPY docker/inference/wheelhouse/ /opt/wheelhouse/

RUN cargo build --release --locked --bin sock && \
    cp target/release/sock /usr/local/bin/sock

RUN git clone --depth 1 --branch "${LINX_REF}" "${LINX_REPO}" /opt/linx && \
    cargo build --release --locked --manifest-path /opt/linx/Cargo.toml && \
    cp /opt/linx/target/release/linx /usr/local/bin/linx

RUN python3 -m venv /opt/sock/vllm/.venv && \
    /opt/sock/vllm/.venv/bin/python -m pip install --upgrade pip "setuptools>=77.0.3,<80.0.0" wheel && \
    /opt/sock/vllm/.venv/bin/python -m pip install -r requirements.txt && \
    torch_wheel="$(find /opt/wheelhouse -maxdepth 1 -name 'torch*.whl' | sort | head -n 1)" && \
    if [ -z "${torch_wheel}" ]; then \
      echo "Missing gfx1151 torch wheel. Copy torch-*-linux_x86_64.whl into docker/inference/wheelhouse/ before building." >&2; \
      exit 64; \
    fi && \
    /opt/sock/vllm/.venv/bin/python -m pip install "${torch_wheel}" && \
    grep -vE '^(--extra-index-url|torch==|torchvision==|torchaudio==)' vllm/requirements/build/rocm.txt > vllm/requirements/build/rocm-no-torch.txt && \
    grep -vE '^(torch==|torchvision==|torchaudio==)' vllm/requirements/rocm.txt > vllm/requirements/rocm-no-torch.txt && \
    /opt/sock/vllm/.venv/bin/python -m pip install -r vllm/requirements/build/rocm-no-torch.txt -r vllm/requirements/rocm-no-torch.txt && \
    cd /opt/sock/vllm && \
    SETUPTOOLS_SCM_PRETEND_VERSION="${VLLM_VERSION}" \
    VLLM_TARGET_DEVICE=rocm \
    PYTORCH_ROCM_ARCH="${PYTORCH_ROCM_ARCH}" \
    MAX_JOBS="${MAX_JOBS}" \
    /opt/sock/vllm/.venv/bin/python -m pip install --no-build-isolation -e .

COPY docker/inference/entrypoint.sh /usr/local/bin/sock-inference-entrypoint
COPY docker/inference/generate-api-key.sh /usr/local/bin/sock-generate-api-key
RUN chmod +x /usr/local/bin/sock-inference-entrypoint /usr/local/bin/sock-generate-api-key

ENV SOCK_MODEL=Qwen/Qwen3-30B-A3B-GPTQ-Int4 \
    SOCK_HOST=0.0.0.0 \
    SOCK_PORT=8000 \
    SOCK_SERVED_MODEL_NAME=Qwen/Qwen3-30B-A3B-GPTQ-Int4 \
    SOCK_MAX_MODEL_LEN=8192 \
    SOCK_GPU_MEMORY_UTILIZATION=0.90 \
    SOCK_MAX_NUM_BATCHED_TOKENS=8192 \
    SOCK_MAX_NUM_SEQS=32 \
    SOCK_KV_LAYOUT=tmh \
    SOCK_TMH_HOT_BUDGET_PCT=25 \
    SOCK_ATTENTION_BACKEND=TRITON_ATTN \
    SOCK_CHAT_TEMPLATE=/opt/sock/docker/inference/templates/sock-agent.jinja \
    SOCK_TRUST_REQUEST_CHAT_TEMPLATE=0 \
    SOCK_ENFORCE_EAGER=1 \
    SOCK_EXTRA_ARGS="" \
    LINX_HTTP_ADDR=0.0.0.0:18110 \
    LINX_PUBLIC_BASE_URL=http://127.0.0.1:18110 \
    LINX_DATA_DIR=/data/linx \
    LINX_SERVICE_NAME=sock-qwen3 \
    LINX_AUTH_MODE=public \
    LINX_TTL_SECS=0 \
    RUST_LOG=info

VOLUME ["/data", "/root/.cache/huggingface"]
EXPOSE 8000 18110

ENTRYPOINT ["sock-inference-entrypoint"]
