LINX_JWT_SECRET=change-this-long-random-secret
LINX_PUBLIC_BASE_URL=http://127.0.0.1:18110
LINX_AUTH_MODE=public
LINX_TTL_SECS=0

SOCK_API_KEY=
SOCK_API_KEYS=
SOCK_MODEL=Qwen/Qwen3-30B-A3B-GPTQ-Int4
SOCK_SERVED_MODEL_NAME=Qwen/Qwen3-30B-A3B-GPTQ-Int4
SOCK_MAX_MODEL_LEN=8192
SOCK_GPU_MEMORY_UTILIZATION=0.90
SOCK_MAX_NUM_BATCHED_TOKENS=8192
SOCK_MAX_NUM_SEQS=32
SOCK_KV_LAYOUT=tmh
SOCK_TMH_HOT_BUDGET_PCT=25
SOCK_ATTENTION_BACKEND=TRITON_ATTN
SOCK_ENFORCE_EAGER=1
SOCK_EXTRA_ARGS=

PYTORCH_ROCM_ARCH=gfx1151
MAX_JOBS=8
SOCK_HOST_PORT=8000
LINX_HOST_PORT=18110
HF_HOME=/home/deepsaint/.cache/huggingface
SOCK_DATA_DIR=/home/deepsaint/.sock-inference

# Use 32768 for frontier/capacity tests. 8192 is the default throughput profile.
# SOCK_MAX_MODEL_LEN=32768
